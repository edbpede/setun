# Two hostnames, both terminating TLS here (PRD §6.2):
#
#   the application origin — everything authenticated
#   the sandbox origin     — static artifact host, no application access
#
# TLS: automatic HTTPS via ACME where the host is publicly reachable. On a closed
# network, replace the `tls` line in each block with `tls internal` to use Caddy's
# internal CA.

# Quoted, because the variable is optional on both sides: docker-compose.yml
# passes `${SETUN_ACME_EMAIL:-}` and scripts/devsuite has no address to give at
# all. Unquoted, an unset variable leaves `email` with no argument, which Caddy
# rejects at parse time — the server never starts, and the message names this
# line rather than the empty variable behind it. Quoted, it is one empty
# argument and ACME simply registers without a contact address.
{
	email "{$SETUN_ACME_EMAIL}"
}

# Application origin.
#
# The upstream is a variable with the deployment's own value as its default, so
# this file is the one Caddy reads in both places rather than a production file
# with a development copy beside it. In deployment the app is a container on the
# same network and `app:3000` is the answer; under scripts/devsuite the app runs
# on the host, so the suite points this at `host.docker.internal:<app port>`.
{$SETUN_APP_HOSTNAME} {
	encode zstd gzip
	reverse_proxy {$SETUN_APP_UPSTREAM:app:3000}
}

# Sandbox origin — prebuilt static files only. It proxies nothing, so generated
# code has no route back into the application from here (§6, §14).
{$SETUN_SANDBOX_HOSTNAME} {
	encode zstd gzip
	root * /srv/sandbox
	file_server

	header {
		# The runner page is embedded in an iframe sandboxed WITHOUT
		# `allow-same-origin` (§14), so its document has an opaque origin and every
		# module script, import map entry and WebAssembly fetch it makes — including
		# the ones addressed to this very host — is a cross-origin request sent with
		# `Origin: null`. Everything served here is public, static and carries no
		# credential, so `*` is the correct answer and not a concession.
		Access-Control-Allow-Origin "*"
		X-Content-Type-Options "nosniff"

		# The isolation that matters (§14). `default-src 'none'` denies outbound
		# network access by default; the sandbox host appears only where this
		# origin must load its own pinned runtimes, compiler and utility CSS.
		# `connect-src` reaches no further, so an artifact cannot call an
		# authenticated API or fetch anything external. The artifact's own document
		# adds `connect-src 'none'` on top, and additional policies intersect.
		Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob: {$SETUN_SANDBOX_HOSTNAME}; style-src 'unsafe-inline' {$SETUN_SANDBOX_HOSTNAME}; img-src data: blob: {$SETUN_SANDBOX_HOSTNAME}; font-src data: {$SETUN_SANDBOX_HOSTNAME}; media-src data: blob:; connect-src blob: data: {$SETUN_SANDBOX_HOSTNAME}; worker-src blob:; frame-src 'self' blob: data:; form-action 'none'; base-uri 'none'; frame-ancestors {$SETUN_APP_HOSTNAME}"

		# Nothing here is per-user, so nothing here needs a referrer or a server
		# banner. Artifacts are named by opaque identifiers all the same (§21).
		Referrer-Policy "no-referrer"
		-Server
	}
}

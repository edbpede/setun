{
  "name": "setun",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build && bun run build:sandbox",
    "build:sandbox": "bun --bun vite build --config sandbox/vite.config.ts && SETUN_SANDBOX_BUILD_TARGET=runtimes bun --bun vite build --config sandbox/vite.config.ts",
    "dev:sandbox": "bun --bun vite dev --config sandbox/vite.config.ts",
    "preview:sandbox": "bun --bun vite preview --config sandbox/vite.config.ts",
    "preview": "bun --bun vite preview",
    "start": "bun ./build/index.js",
    "prepare": "test -f project.inlang/settings.json || exit 0; paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome ci",
    "format": "biome check --write",
    "test:component": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@inlang/paraglide-js": "^2.24.1",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.33.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@unocss/preset-wind4": "^66.8.1",
    "@unocss/runtime": "^66.8.1",
    "@vitest/browser-playwright": "^4.1.11",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.4.14",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild-wasm": "^0.28.2",
    "marked": "^18.0.10",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn-svelte": "1.5.0",
    "shiki": "^4.4.3",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "sveltekit-superforms": "^2.30.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "typescript": "^6.0.3",
    "unocss": "^66.8.1",
    "unocss-preset-animations": "^1.3.0",
    "unocss-preset-shadcn": "^1.0.1",
    "valibot": "^1.4.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-browser-svelte": "^3.0.0"
  }
}

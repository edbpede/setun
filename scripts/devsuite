#!/usr/bin/env python3
"""
Setun development suite — one entry point for the whole local stack.

This file is only the entry point. Everything it does lives in the `devsuite`
package next to it (`scripts/lib/devsuite/`), whose docstring describes the
stack, the two shapes it runs in, and the layer each module owns.

`scripts/lib` is put on the path rather than the package being installed: the
suite runs from a checkout, needs nothing but the standard library, and an
install step would be one more thing between `git clone` and a working stack.

  ./scripts/devsuite start     bring the stack up and attach to the log view
  ./scripts/devsuite --help    every command and flag
"""

import platform
import sys
from pathlib import Path

# Checked here, before the package is imported, because the failure it prevents
# is a SyntaxError from a module three imports deep. The package is written to
# .agents/rules/python-3_14-core.md: deferred annotations (PEP 649) and
# parenthesis-free `except` (PEP 758) are both 3.14, and neither degrades — an
# older interpreter cannot parse the files at all.
if sys.version_info < (3, 14):
    raise SystemExit(
        f"the dev suite needs Python 3.14 or newer; this is {platform.python_version()}.\n"
        f"  {sys.executable}\n"
        "Install one and re-run — for example `uv python install 3.14`, or brew/pyenv."
    )

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from devsuite.cli import main  # noqa: E402 — the path above is what makes it importable

if __name__ == "__main__":
    sys.exit(main())
